{
	"/": [
		"src/routes/+server.ts"
	],
	"/.well-known/security.txt": [
		"src/routes/.well-known/security.txt/+server.ts"
	],
	"/api/assets/[[action]]": [
		"src/routes/api/assets/[[action]]/+server.ts"
	],
	"/api/check-assets/[[mode]]": [
		"src/routes/api/check-assets/[[mode]]/+server.ts"
	],
	"/api/downloader": [
		"src/routes/api/downloader/+server.ts"
	],
	"/api/downloads": [
		"src/routes/api/downloads/+server.ts"
	],
	"/api/downloads/[id]": [
		"src/routes/api/downloads/[id]/+server.ts"
	],
	"/api/downloads/[id]/file": [
		"src/routes/api/downloads/[id]/file/+server.ts"
	],
	"/api/image/[...path]": [
		"src/routes/api/image/[...path]/+server.ts"
	],
	"/api/[...path]": [
		"src/routes/api/[...path]/+server.ts"
	],
	"/robots.txt": [
		"src/routes/robots.txt/+server.ts"
	]
}